      "text": "Es substring, no fuzzy: 'uber eats' gana a 'uber' solo porque\nel indice esta ordenado de etiqueta mas larga a mas corta.\nDatos semilla: 6 categorias, ~20 merchants (persistence/seed.py).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Es substring, no fuzzy: 'uber eats' gana a 'uber' solo porque\nel indice esta ordenado de etiqueta mas larga a mas corta.\nDatos semilla: 6 categorias, ~20 merchants (persistence/seed.py).",
      "lineHeight": 1.25,
      "baseline": 14
    },
