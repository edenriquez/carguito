# Carguito backend configuration.

# SQLAlchemy database URL. Defaults to a local SQLite file for offline dev.
# For Supabase Postgres use e.g.:
#   postgresql+psycopg2://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres
# DATABASE_URL=sqlite:///carguito.db

# Supabase JWT secret used to verify bearer tokens from the mobile/web clients.
# Found in Supabase project settings -> API -> JWT Secret.
# SUPABASE_JWT_SECRET=your-jwt-secret

# When true, auth is bypassed and requests run as DEV_USER_ID (local dev only).
AUTH_DISABLED=true
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Where the DuckDB analytics cube file lives.
# CUBE_PATH=carguito_cube.duckdb

# CORS origins (comma separated). Use explicit origins in production.
CORS_ORIGINS=*

# Where the web dashboard lives. Used to build the "Ver en tu dashboard" link
# the device ingest endpoint returns to the phone.
FRONTEND_URL=http://localhost:3000

# The X25519 keypair phones seal their extracted text to. Minted on first
# bootstrap; gitignored, and a secret — losing it only costs the phones a
# re-pin, leaking it undoes the sealed envelope.
# INGEST_KEY_PATH=ingest_key.json

# --- Workspace chat (optional) -----------------------------------------------
# The one non-deterministic part of the product, and the only optional
# integration. Any endpoint that speaks OpenAI-shaped Chat Completions works:
# OpenRouter, Groq, Together, or a local Ollama at http://localhost:11434/v1.
#
# Leave all three unset and the chat band renders disabled with its reason —
# a supported state, not a broken one. Everything else in Workspace still reads.
#
# The key is a secret: keep it here, never in the repo.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=minimax/minimax-m3
# LLM_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Reference prices for the Precios chat (both optional, both fail to "no reference").
# PRICE_REFERENCE_CITY: Profeco QQP survey area; 1502 = Valle de México. "" disables.
# LISTINGS_SOURCE: "" (off), "firecrawl" (recommended; free plan, no card, https://firecrawl.dev),
#                  "brave" (key + card), "amazon" (no key, fragile).
PRICE_REFERENCE_CITY=1502
LISTINGS_SOURCE=
FIRECRAWL_API_KEY=
BRAVE_SEARCH_API_KEY=

# --- Typed decisions (optional, independent of the chat above) ---------------
# A System One model (TypeSafe's Jev): state in, a typed value out with the
# probability distribution it came from. It does NOT write answers and is not a
# replacement for the chat above -- it decides, the chat explains.
#
# Today it proposes the generic name a ticket line is filed under, choosing
# from the words this account already uses plus a seed vocabulary. Below its
# confidence threshold it hands the line to the text model, exactly as before.
#
# Access is by early access at https://console.typesafe.ai. Unset is a
# supported state: the feature falls back to the text model, and with neither
# configured the screen says "sin asociar" and the user types the term.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
